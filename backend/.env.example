# ─────────────────────────────────────────────────────────────
#  SUPABASE DATABASE (use your Supabase Postgres connection string)
# ─────────────────────────────────────────────────────────────
# 1. Go to supabase.com → Create a new project
# 2. In your project dashboard, go to: Project Settings → Database
# 3. Under "Connection string", select "URI" and copy the string.
# 4. Replace YOUR-PASSWORD with your database password.
# 5. Add `?sslmode=require` at the end (Prisma needs it).
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require"

# ─────────────────────────────────────────────────────────────
#  EXPRESS SERVER
# ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# ─────────────────────────────────────────────────────────────
#  JWT AUTH
# ─────────────────────────────────────────────────────────────
JWT_SECRET="a-super-secret-key-change-this"
JWT_EXPIRES_IN="7d"

# ─────────────────────────────────────────────────────────────
#  GROQ AI API (for LeetCode, PPT generation, etc.)
# ─────────────────────────────────────────────────────────────
# Get your key from: https://console.groq.com
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────
#  GMAIL SMTP (I'll use this for OTP + Imposition mail)
# ─────────────────────────────────────────────────────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an app password for "Mail"
# 4. Use your email and that app password below
# ─────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
MAIL_FROM='"CSE AIML Monitor" <your-email@gmail.com>'

# ─────────────────────────────────────────────────────────────
#  DEFAULT ADMIN (created by seed script)
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@cseaiml.edu"
ADMIN_PASSWORD="Admin@123"

# ─────────────────────────────────────────────────────────────
#  GITHUB OAUTH (for student GitHub linking)
# ─────────────────────────────────────────────────────────────
# Get credentials from: https://github.com/settings/developers
# New OAuth App → Homepage: http://localhost:5173
# Callback: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:5000/api/auth/github/callback"

# ─────────────────────────────────────────────────────────────
#  LEETCODE (public API – no keys required)
# ─────────────────────────────────────────────────────────────
LEETCODE_API_BASE="https://leetcode.com/graphql"